rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows anyone to read
    match /{document=**} {
      allow read: if true;
    }

    // Products: Admin (verified by client-side PIN logic for now, or Auth) can write
    // Since you asked for specific rules for anonymous auth/PIN, we will keep it simple
    // but robust enough. Since "PIN" is client-side, Firestore rules cannot strictly check a PIN string
    // unless it is stored in the user object or sent as data.
    // However, if you have Anonymous Auth enabled:
    match /products/{productId} {
      allow write: if request.auth != null;
    }
    
    // Messages: Anyone can create (public contact form), only Admin (Auth) can read/delete
    match /messages/{messageId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }

    // Settings: Admin (Auth) write, Public read
    match /settings/{docId} {
      allow write: if request.auth != null;
    }

    // Banners: Admin (Auth) write, Public read
    match /banners/{bannerId} {
      allow write: if request.auth != null;
    }
  }
}
